# ---- Hostinger par ye values hPanel > Website > Node.js > Environment variables mein hoti hain ----
NEXT_PUBLIC_SITE_URL=https://sahikaam.com
NEXT_PUBLIC_SUPPORT_EMAIL=team@sahikaam.com
NEXT_PUBLIC_SUPPORT_WHATSAPP=918269164260

# Database (Hostinger MySQL). Website ke andar se host hamesha 127.0.0.1
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/DBNAME

# Login cookies ke liye random 64-character secret
APP_SECRET=

# Login code email (Hostinger mailbox)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=team@sahikaam.com
SMTP_PASS=
EMAIL_FROM=SahiKaam <team@sahikaam.com>

# Razorpay (pehle rzp_test_..., KYC ke baad rzp_live_...)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Mobile number login by SMS (optional; without it only email login shows on the live site)
# fast2sms: SMS_PROVIDER=fast2sms, SMS_API_KEY=<Fast2SMS API key>  (OTP route)
# msg91:    SMS_PROVIDER=msg91,    SMS_API_KEY=<MSG91 authkey>, SMS_TEMPLATE_ID=<DLT OTP template id>
SMS_PROVIDER=
SMS_API_KEY=
SMS_TEMPLATE_ID=

# Owner emails that can open /admin (account recovery), comma separated
ADMIN_EMAILS=
