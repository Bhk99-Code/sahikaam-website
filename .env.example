# ---- Hostinger par ye values hPanel > Website > Node.js > Environment variables mein hoti hain ----
NEXT_PUBLIC_SITE_URL=https://sahikaam.com
NEXT_PUBLIC_SUPPORT_EMAIL=team@sahikaam.com
NEXT_PUBLIC_SUPPORT_WHATSAPP=918269164260

# Database (Hostinger MySQL). Website ke andar se host hamesha 127.0.0.1
