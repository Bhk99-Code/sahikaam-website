# Login cookies ke liye random 64-character secret
APP_SECRET=

# Login code email (Hostinger mailbox)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=team@sahikaam.com
SMTP_PASS=
EMAIL_FROM=SahiKaam <team@sahikaam.com>

# Razorpay (pehle rzp_test_..., KYC ke baad rzp_live_...)
